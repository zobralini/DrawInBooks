{
	"schemaVersion": 1,
	"id": "drawinbooks",
	"version": "${version}",
	"name": "Draw In Books",
	"description": "Draw on book & quill pages, in five colors, alongside the text. Drawings ride along on the book inside vanilla's custom_data, so the mod is optional: players without it just see an ordinary book. Install it server side (or the server plugin) to make drawings save in survival.",
	"authors": [
		"zobra"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/draw-in-books",
		"sources": "https://github.com/zobralini/DrawInBooks",
		"issues": "https://github.com/zobralini/DrawInBooks/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/drawinbooks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.drawinbooks.DrawInBooks"
		],
		"client": [
			"com.drawinbooks.client.DrawInBooksClient"
		]
	},
	"mixins": [
		{
			"config": "drawinbooks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
